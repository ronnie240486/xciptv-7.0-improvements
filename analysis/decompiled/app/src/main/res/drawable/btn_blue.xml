<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="1dp"/>
            <solid android:color="@color/orplayer_focuse_item_color"/>
            <stroke
                android:width="0.7dp"
                android:color="@color/orplayer_second_bg_color"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="1dp"/>
            <solid android:color="@color/orplayer_second_bg_color"/>
            <stroke
                android:width="0.7dp"
                android:color="#ffffff"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="1dp"/>
            <solid android:color="@color/orplayer_second_bg_color"/>
            <stroke
                android:width="0.3dp"
                android:color="#6fc7cbcc"/>
        </shape>
    </item>
</selector>
