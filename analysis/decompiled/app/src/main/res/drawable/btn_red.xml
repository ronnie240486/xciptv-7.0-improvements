<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="1dp"/>
            <solid android:color="@color/orplayer_focuse_item_color"/>
            <stroke
                android:width="0.5dp"
                android:color="#bc131313"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="1dp"/>
            <solid android:color="#730828"/>
            <stroke
                android:width="0.5dp"
                android:color="#ffffff"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="1dp"/>
            <solid android:color="#730828"/>
            <stroke
                android:width="0.5dp"
                android:color="#5b575c"/>
        </shape>
    </item>
</selector>
