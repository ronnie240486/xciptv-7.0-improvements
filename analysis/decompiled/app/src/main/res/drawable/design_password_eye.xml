<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="0x7f0b0526"
        android:drawable="0x7f0805b8"/>
    <item
        android:id="@+id/masked"
        android:drawable="0x7f0805b9"/>
    <transition
        android:drawable="@drawable/avd_show_password"
        android:toId="0x7f0b0526"
        android:fromId="@+id/masked"/>
    <transition
        android:drawable="@drawable/avd_hide_password"
        android:toId="@+id/masked"
        android:fromId="0x7f0b0526"/>
</animated-selector>
