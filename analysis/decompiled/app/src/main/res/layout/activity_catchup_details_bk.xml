<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.exoplayer2.ui.SimpleExoPlayerView
        android:id="@+id/player_view4"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"/>
    <FrameLayout
        android:id="@+id/layout_player_top_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/layout_list_cud"
            android:background="#88000000"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="100dp">
            <ListView
                android:id="@+id/listview_cud"
                android:layout_width="350dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_media_control"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <SeekBar
            android:id="@+id/seekbar_video"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginLeft="75dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="70dp"
            android:progressDrawable="@drawable/lib_player_seekbar_play"
            android:thumb="@drawable/lib_player_seekbar_play_thumb"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/layout_overlay_cud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="12dp">
            <FrameLayout
                android:id="@+id/layout_cu_desc"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:id="@+id/txt_desc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">
                <ImageButton
                    android:id="@+id/btn_p_rewind"
                    android:background="@drawable/btn_player_rewind"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btn_p_play"
                    android:background="@drawable/btn_player_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btn_p_forward"
                    android:background="@drawable/btn_player_forward"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="0x7f0b00eb"
                    android:background="@drawable/btn_player_menu"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginLeft="50dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:id="@+id/txt_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="12dp"
            android:text="00:00:00"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="right"
            android:id="@+id/txt_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="22dp"
            android:text="00:00:00"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/layout_seekbar_holder"
        android:background="#353737"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="70dp">
        <SeekBar
            android:layout_gravity="center_vertical"
            android:id="@+id/seekbar_audio"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="45dp"
            android:layout_marginRight="10dp"
            android:max="100"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/imageView23"
            android:background="@drawable/sound_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"/>
    </FrameLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar_cud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        style="?android:attr/progressBarStyle"/>
</FrameLayout>
