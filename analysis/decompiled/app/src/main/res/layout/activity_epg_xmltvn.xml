<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/orplayer_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView22"
        android:background="@drawable/bg2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"/>
    <ImageView
        android:id="@+id/imageView11"
        android:background="@drawable/corner_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/top_shadow5"
        android:background="@drawable/top_shadow"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:alpha="0.8"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#72c8f1"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textView122"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUIDE"
                    android:fontFamily="@font/quicksand_light"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#72c8f1"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textView12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:text="|"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#72c8f1"
                    android:layout_gravity="center"
                    android:id="@+id/txt_left_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:fontFamily="@font/quicksand_light"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/layout_info_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp">
                <ImageView
                    android:layout_gravity="right"
                    android:id="@+id/imageView27"
                    android:background="@drawable/logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="20dp"
                    android:alpha="0.2"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="20sp"
                        android:textColor="#c9e9f8"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/txt_epg_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_light"/>
                    <TextView
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/txt_epg_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:fontFamily="@font/quicksand_light"/>
                    <TextView
                        android:textColor="#b2def3"
                        android:layout_gravity="center"
                        android:id="@+id/txt_epg_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:lines="3"
                        android:fontFamily="@font/quicksand_light"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_epg_holder_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="2dp">
                <HorizontalScrollView
                    android:background="#9a0c0c0c"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/layout_cat_btn_holder"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                </HorizontalScrollView>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:id="@+id/layout_ch_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.nathnetwork.xciptv.ScrollDisabledListView
                            android:id="@+id/listview_ch"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:divider="@null"/>
                    </LinearLayout>
                    <HorizontalScrollView
                        android:id="@+id/h_scrollview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <FrameLayout
                                android:id="@+id/layout_epg_holder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawSelectorOnTop="false"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <ListView
                                    android:id="@+id/listview_pr"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:divider="@null"/>
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
