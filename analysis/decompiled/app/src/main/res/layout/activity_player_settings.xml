                        android:textColor="#7bcad5"
                        android:id="@+id/rb_40sec_exo"
                        android:clickable="true"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="40 Sec"
