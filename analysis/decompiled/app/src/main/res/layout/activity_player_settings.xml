                    android:id="@+id/rb_gr_zoom_vlc"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <RadioButton
                        android:textColor="#edd99d"
                        android:id="@+id/rb_zoom_best_fit_vlc"
                        android:layout_width="120dp"
