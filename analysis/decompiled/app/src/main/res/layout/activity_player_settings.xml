                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Fixed Height"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:textColor="#edd99d"
                        android:id="@+id/rb_zoom_fixed_width_exo"
