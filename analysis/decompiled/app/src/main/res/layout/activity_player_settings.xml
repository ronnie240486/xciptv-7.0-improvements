                        android:layout_weight="1"/>
                    <RadioButton
                        android:textColor="#7bcad5"
                        android:id="@+id/rb_2sec_vlc"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="2 sec"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:textColor="#7bcad5"
                        android:id="@+id/rb_3sec_vlc"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="3 Sec"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:textColor="#7bcad5"
                        android:id="@+id/rb_5sec_vlc"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="5 Sec"/>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
