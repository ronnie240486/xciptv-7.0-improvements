                        android:textColor="#edd99d"
                        android:id="@+id/rb_zoom_orig_vlc"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Original"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:textColor="#edd99d"
                        android:id="@+id/rb_zoom_fill_vlc"
                        android:layout_width="120dp"
