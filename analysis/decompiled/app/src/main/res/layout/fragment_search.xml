<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#121d27"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="#a90e0e0e"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"/>
    <FrameLayout
        android:background="@color/orplayer_bg_color"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageView14"
            android:background="@drawable/logo"
            android:layout_width="45dp"
            android:layout_height="45dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/orplayer_litegray_font_color"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:id="@+id/textView21"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="GLOBAL SEARCH"
            android:fontFamily="@font/quicksand_light"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/btn_search_frm"
            android:background="@drawable/search_n"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="30dp"
            android:contentDescription="Search"
            android:alpha="0.7"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="bottom"
                android:id="@+id/recyclerview_main_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@color/orplayer_focuse_item_color"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_search_holder"
        android:background="#d7101010"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/orplayer_litegray_font_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView35"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xc_please_wait"
                android:fontFamily="@font/quicksand_medium"/>
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyle"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_search_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/orplayer_litegray_font_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView29"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GLOBAL SEARCH"
                android:fontFamily="@font/quicksand_medium"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="italic"
                android:textColor="@color/orplayer_skyblue_font_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView36"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE TV, VODs, AND SERIES"
                android:fontFamily="@font/quicksand_medium"/>
            <TextView
                android:textColor="@color/orplayer_litegray_font_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView37"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Search TV Channel Name, Movie&apos;s Name, or Series Name."
                android:fontFamily="@font/quicksand_medium"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="italic"
                android:textColor="@color/orplayer_skyblue_font_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_search_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE TV AND GUIDE"
                android:fontFamily="@font/quicksand_medium"/>
            <TextView
                android:textColor="@color/orplayer_litegray_font_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_search_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Search Live TV Channel&apos;s name and program title from TV Guide. "
                android:fontFamily="@font/quicksand_medium"/>
            <EditText
                android:textSize="20sp"
                android:textColor="@android:color/black"
                android:id="@+id/ed_search"
                android:background="@drawable/xciptv_ed"
                android:paddingLeft="10dp"
                android:nextFocusLeft="@+id/btn_search"
                android:nextFocusRight="@+id/btn_search"
                android:nextFocusUp="@+id/btn_search"
                android:nextFocusDown="@+id/btn_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/xc_search"
                android:ems="10"
                android:singleLine="true"
                android:inputType="none"
                android:imeOptions="actionSearch"
                android:nextFocusForward="@+id/btn_search"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:id="@+id/btn_cancel"
                    android:background="@drawable/btn_red"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/xc_cancel_str"
                    android:fontFamily="@font/quicksand_regular"/>
                <Button
                    android:id="@+id/btn_search_tv_vod_series"
                    android:background="@drawable/btn"
                    android:layout_width="180dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:text="LIVE TV, VOD and Series"
                    android:layout_weight="1"
                    android:fontFamily="@font/quicksand_regular"/>
                <Button
                    android:id="@+id/btn_search_epg"
                    android:background="@drawable/btn"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="10dp"
                    android:text="Live TV and Guide"
                    android:fontFamily="@font/quicksand_regular"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
