<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ch_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/cardview"
        android:background="@drawable/cardview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#92045478"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardUseCompatPadding="false">
        <LinearLayout
            android:orientation="vertical"
            android:background="#151515"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0.4dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="top"
                    android:id="@+id/img_ch"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:layout_margin="2dp"
                    android:src="@drawable/logo"/>
                <ImageView
                    android:layout_gravity="top|right"
                    android:id="@+id/img_fav"
                    android:background="@drawable/start_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="0.5dp">
                <FrameLayout
                    android:id="@+id/laytou_title_holder"
                    android:background="#a8323131"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@android:color/background_light"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/txt_channel_name_list"
                        android:paddingLeft="3dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="2dp"
                        android:lines="2"
                        android:fontFamily="@font/quicksand_regular"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
