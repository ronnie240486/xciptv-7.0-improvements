<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#d82b2a2a"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/background_light"
                android:gravity="center"
                android:id="@+id/txt_title"
                android:background="#a30f100f"
                android:paddingTop="5dp"
                android:paddingBottom="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xc_parental_control_setup"
                android:fontFamily="@font/quicksand_regular"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="@android:color/background_light"
                android:id="@+id/txt_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="@string/xc_uninstall_app_to_reset_p_pass"
                android:fontFamily="@font/quicksand_regular"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@android:color/background_light"
                        android:id="@+id/txt_old_pass_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xc_old_pass"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_regular"/>
                    <EditText
                        android:textSize="16sp"
                        android:id="@+id/ed_old_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/xc_current_pass"
                        android:password="true"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/quicksand_regular"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@android:color/background_light"
                        android:id="@+id/txt_new_password_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xc_new_pass"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_regular"/>
                    <EditText
                        android:textSize="16sp"
                        android:id="@+id/ed_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/xc_password"
                        android:password="true"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/quicksand_regular"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="25dp"
            android:layout_below="@+id/textview_title"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="15sp"
                    android:id="@+id/btn_cancel"
                    android:background="@drawable/btn_red"
                    android:layout_width="180dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/xc_cancel_str"
                    android:layout_weight="1"
                    android:fontFamily="@font/quicksand_regular"/>
                <Button
                    android:textSize="15sp"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_change"
                    android:background="@drawable/btn"
                    android:paddingLeft="5dp"
                    android:layout_width="180dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/xc_change_password"
                    android:layout_weight="1"
                    android:fontFamily="@font/quicksand_regular"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
