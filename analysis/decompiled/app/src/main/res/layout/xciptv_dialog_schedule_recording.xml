<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#d82b2a2a"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="24sp"
            android:textColor="#ffb300"
            android:gravity="center"
            android:id="@+id/textView20"
            android:background="#006d6767"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule your Recording"
            android:fontFamily="@font/quicksand_regular"/>
        <FrameLayout
            android:background="#da6d6a6a"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_date"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="00 000 0000"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_medium"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_time"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginLeft="30dp"
                android:text="00:00"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_medium"/>
            <Button
                android:layout_gravity="center"
                android:id="@+id/btn_pick_date"
                android:background="@drawable/btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="25dp"
                android:text="Pick Datetime"
                android:layout_weight="1"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="350dp"
            android:layout_height="51dp"
            android:layout_marginTop="10dp">
            <EditText
                android:textSize="24sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/ed_min"
                android:background="#4d039be5"
                android:layout_width="98dp"
                android:layout_height="40dp"
                android:hint="0"
                android:ems="10"
                android:inputType="number"
                android:fontFamily="@font/quicksand_medium"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txt_time2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Length in Minutes"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_medium"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp">
            <Button
                android:id="@+id/btn_cancel"
                android:background="@drawable/btn_red"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/xc_cancel_str"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
            <Button
                android:layout_gravity="right"
                android:id="@+id/btn_schedule"
                android:background="@drawable/btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="5dp"
                android:text="Schedule"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
