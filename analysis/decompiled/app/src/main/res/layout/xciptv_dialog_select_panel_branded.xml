<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#d82b2a2a"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="#f1eded"
            android:gravity="center"
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S E L E C T    P A N E L"
            android:fontFamily="@font/quicksand_bold"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp">
            <Button
                android:id="@+id/btn_panel1"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:text="PANEL 1"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
            <ImageView
                android:id="@+id/img_p1_selected"
                android:background="@drawable/selected_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp">
            <Button
                android:id="@+id/btn_panel2"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:text="PANEL 2"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
            <ImageView
                android:id="@+id/img_p2_selected"
                android:background="@drawable/selected_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp">
            <Button
                android:id="@+id/btn_panel3"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:text="PANEL 3"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
            <ImageView
                android:id="@+id/img_p3_selected"
                android:background="@drawable/selected_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp">
            <Button
                android:id="@+id/btn_panel4"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:text="PANEL 4"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
            <ImageView
                android:id="@+id/img_p4_selected"
                android:background="@drawable/selected_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp">
            <Button
                android:id="@+id/btn_panel5"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:text="PANEL 5"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"/>
            <ImageView
                android:id="@+id/img_p5_selected"
                android:background="@drawable/selected_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
